generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type AdjustbetsCockfight {
  commissionRBG Int
  enabled       Boolean
  lastError     String?
  lastSavedAt   DateTime? @db.Date
  profile       Int
  statusServe   String?
  work          Boolean
}

