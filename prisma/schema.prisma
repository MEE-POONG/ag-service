// ==================== Customer Chat System Models ====================

// Chat Customer - represents customers who use the chat system
model ChatCustomerDB {
  id            String                  @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String                  @unique // External customer ID
  name          String?
  email         String?
  phone         String?
  password      String? // Hashed password for widget auth
  avatarUrl     String?
  // Custom fields for segmentation
  language      String                  @default("th") // th, en
  timezone      String                  @default("Asia/Bangkok")
  metadata      Json? // Additional custom fields
  // Status
  isActive      Boolean                 @default(true)
  isBlocked     Boolean                 @default(false)
  blockedReason String?
  source        String? // Registration source (widget_registration, manual, etc.)
  // Timestamps
  createdAt     DateTime                @default(now()) @db.Date
  updatedAt     DateTime                @updatedAt @db.Date
  lastSeenAt    DateTime?               @db.Date
  lastLoginAt   DateTime?               @db.Date
  // Relations
  conversations ChatConversationDB[]
  messages      ChatMessageDB[]
  tags          ChatCustomerTagDB[]
  segments      ChatCustomerSegmentDB[]

  @@index([email])
  @@index([phone])
  @@index([isActive])
  @@index([source])
  @@index([createdAt])
  @@index([lastLoginAt])
}

// Chat Conversation - represents individual chat threads
model ChatConversationDB {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  customerId      String           @db.ObjectId
  customer        ChatCustomerDB   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Agent assignment
  assignedAdminId String?          @db.ObjectId
  assignedAdmin   AdminDB?         @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  // Widget key reference
  widgetKeyId     String?          @db.ObjectId
  widgetKey       ChatWidgetKeyDB? @relation(fields: [widgetKeyId], references: [id], onDelete: SetNull)
  // Status
  status          String           @default("open") // open, assigned, resolved, closed
  priority        String           @default("normal") // low, normal, high, urgent
  // Content
  subject         String?
  lastMessage     String?
  lastMessageAt   DateTime?        @db.Date
  // Flags
  isUnread        Boolean          @default(true)
  unreadCount     Int              @default(0)
  // Timestamps
  createdAt       DateTime         @default(now()) @db.Date
  updatedAt       DateTime         @updatedAt @db.Date
  resolvedAt      DateTime?        @db.Date
  closedAt        DateTime?        @db.Date
  // Relations
  messages        ChatMessageDB[]

  @@index([customerId])
  @@index([assignedAdminId])
  @@index([widgetKeyId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([lastMessageAt])
}

// Chat Message - individual messages in conversations
model ChatMessageDB {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String              @db.ObjectId
  conversation   ChatConversationDB  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId     String              @db.ObjectId
  customer       ChatCustomerDB      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Widget key reference
  widgetKeyId    String?             @db.ObjectId
  widgetKey      ChatWidgetKeyDB?    @relation(fields: [widgetKeyId], references: [id], onDelete: SetNull)
  // Sender info
  senderType     String // customer, agent, system
  senderId       String?             @db.ObjectId // AdminDB id if agent
  senderName     String?
  // Message content
  messageType    String              @default("text") // text, image, file, video, audio, location, card, richMenu
  content        String // Text content or JSON for rich messages
  attachments    Json? // Array of attachment objects
  metadata       Json? // Additional metadata
  // Status
  isRead         Boolean             @default(false)
  readAt         DateTime?           @db.Date
  isSent         Boolean             @default(true)
  sentAt         DateTime            @default(now()) @db.Date
  // Auto-reply tracking
  isAutoReply    Boolean             @default(false)
  autoReplyId    String?             @db.ObjectId
  // Timestamps
  createdAt      DateTime            @default(now()) @db.Date
  updatedAt      DateTime            @updatedAt @db.Date
  // Read tracking
  readBy         ChatMessageReadDB[]

  @@index([conversationId])
  @@index([customerId])
  @@index([widgetKeyId])
  @@index([senderType])
  @@index([messageType])
  @@index([createdAt])
  @@index([isRead])
}

// Message Read Tracking - Track which admin read which messages
model ChatMessageReadDB {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  messageId String        @db.ObjectId
  message   ChatMessageDB @relation(fields: [messageId], references: [id], onDelete: Cascade)
  adminId   String        @db.ObjectId
  admin     AdminDB       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  readAt    DateTime      @default(now()) @db.Date

  @@unique([messageId, adminId])
  @@index([messageId])
  @@index([adminId])
  @@index([readAt])
}

// Chat Tag - for categorizing customers
model ChatTagDB {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  name        String              @unique
  color       String              @default("#3B82F6") // Hex color code
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Date
  createdBy   String
  updatedAt   DateTime            @updatedAt @db.Date
  updatedBy   String
  // Relations
  customers   ChatCustomerTagDB[]

  @@index([isActive])
}

// Join table for Customer-Tag relationship
model ChatCustomerTagDB {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  customerId String         @db.ObjectId
  customer   ChatCustomerDB @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String         @db.ObjectId
  tag        ChatTagDB      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now()) @db.Date
  createdBy  String

  @@unique([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
}

// Chat Segment - for dynamic customer grouping
model ChatSegmentDB {
  id          String                  @id @default(auto()) @map("_id") @db.ObjectId
  name        String                  @unique
  description String?
  // Segment rules (stored as JSON)
  rules       Json // Filter conditions
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now()) @db.Date
  createdBy   String
  updatedAt   DateTime                @updatedAt @db.Date
  updatedBy   String
  // Relations
  customers   ChatCustomerSegmentDB[]
  broadcasts  ChatBroadcastDB[]

  @@index([isActive])
}

// Join table for Customer-Segment relationship
model ChatCustomerSegmentDB {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  customerId String         @db.ObjectId
  customer   ChatCustomerDB @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segmentId  String         @db.ObjectId
  segment    ChatSegmentDB  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now()) @db.Date
  updatedAt  DateTime       @updatedAt @db.Date

  @@unique([customerId, segmentId])
  @@index([customerId])
  @@index([segmentId])
}

// Auto Reply - automated responses
model ChatAutoReplyDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  // Trigger conditions
  triggerType String // keyword, welcome, away, default
  keywords    String[] // For keyword triggers
  // Response
  messageType String   @default("text") // text, image, card, richMenu
  message     String // Text or JSON content
  attachments Json? // Optional attachments
  // Scheduling
  isActive    Boolean  @default(true)
  startTime   String? // HH:mm format
  endTime     String? // HH:mm format
  daysOfWeek  String[] // ["monday", "tuesday", ...]
  // Priority (higher number = higher priority)
  priority    Int      @default(0)
  // Timestamps
  createdAt   DateTime @default(now()) @db.Date
  createdBy   String
  updatedAt   DateTime @updatedAt @db.Date
  updatedBy   String

  @@index([triggerType])
  @@index([isActive])
  @@index([priority])
}

// Rich Menu - interactive menu for chat widget
model ChatRichMenuDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  // Menu structure (JSON)
  menuData    Json // Contains buttons, actions, layout
  imageUrl    String? // Optional background image
  // Status
  isActive    Boolean  @default(false)
  isDefault   Boolean  @default(false) // Only one can be default
  // Timestamps
  createdAt   DateTime @default(now()) @db.Date
  createdBy   String
  updatedAt   DateTime @updatedAt @db.Date
  updatedBy   String

  @@index([isActive])
  @@index([isDefault])
}

// Broadcast - mass messaging
model ChatBroadcastDB {
  id           String                     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  // Target audience
  targetType   String // all, segment, tag, custom
  segmentId    String?                    @db.ObjectId
  segment      ChatSegmentDB?             @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  customFilter Json? // Custom filter conditions
  // Message content
  messageType  String                     @default("text") // text, image, card
  message      String
  attachments  Json?
  // Scheduling
  status       String                     @default("draft") // draft, scheduled, sending, sent, failed
  scheduledAt  DateTime?                  @db.Date
  sentAt       DateTime?                  @db.Date
  // Statistics
  totalTarget  Int                        @default(0)
  totalSent    Int                        @default(0)
  totalFailed  Int                        @default(0)
  // Timestamps
  createdAt    DateTime                   @default(now()) @db.Date
  createdBy    String
  updatedAt    DateTime                   @updatedAt @db.Date
  updatedBy    String
  // Relations
  recipients   ChatBroadcastRecipientDB[]

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

// Broadcast Recipient - tracking individual broadcast sends
model ChatBroadcastRecipientDB {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  broadcastId  String          @db.ObjectId
  broadcast    ChatBroadcastDB @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  customerId   String          @db.ObjectId
  // Status
  status       String          @default("pending") // pending, sent, failed, read
  errorMessage String?
  sentAt       DateTime?       @db.Date
  readAt       DateTime?       @db.Date
  // Timestamps
  createdAt    DateTime        @default(now()) @db.Date
  updatedAt    DateTime        @updatedAt @db.Date

  @@unique([broadcastId, customerId])
  @@index([broadcastId])
  @@index([customerId])
  @@index([status])
}

