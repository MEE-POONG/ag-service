}

model WebBaseDB {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime   @db.Date
  createdBy String
  isActive  Boolean
  isDeleted Boolean
  name      String     @unique
  otpA      String
  otpM      String
  otpS      String
  passA     String
  passM     String
  passS     String
  updatedAt DateTime   @db.Date
  updatedBy String
