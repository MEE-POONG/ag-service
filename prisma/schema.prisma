  AGUserDB  AGUserDB[]

  @@index([isActive], map: "isActive_1")
}

model WorkHistoryDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  createdAt DateTime @db.Date
  errorMsg  String?
  ipAddress String
  isSuccess Boolean
  newData   String?
  oldData   String?
  recordId  String?  @db.ObjectId
  tableName String
  userAgent String
  userId    String
  userType  String

  @@index([tableName])
  @@index([recordId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

