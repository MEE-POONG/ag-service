}

model AGUserDB {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  adviser   String
  createdAt DateTime  @db.Date
  createdBy String
  isActive  Boolean
  isDeleted Boolean
  password  String
  updatedAt DateTime  @db.Date
  updatedBy String
  userAg    String    @unique
  userLogin String?    @unique
  webBaseId String    @db.ObjectId
  webBase   WebBaseDB @relation(fields: [webBaseId], references: [id], onDelete: Cascade)
}

model ActivityLogDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  createdAt DateTime @db.Date
  ipAddress String?
  newData   String?
  recordId  String?
  tableName String?
  userAgent String?
  userId    String
  userType  String
}

model AdminDB {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  adminPositionId String          @db.ObjectId
  adminPosition   AdminPositionDB @relation(fields: [adminPositionId], references: [id], onDelete: Cascade)
  webBaseId       String?         @db.ObjectId
  webBase         WebBaseDB?      @relation(fields: [webBaseId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @db.Date
  createdBy       String
  deleteAt        DateTime?       @db.Date
  /// Could not determine type: the field only had null or empty values in the sample set.
  deleteBy        Json?
  email           String          @unique
  isActive        Boolean
  name            String
  password        String
  /// Could not determine type: the field only had null or empty values in the sample set.
  profile         Json?
  tel             String
  updatedAt       DateTime        @db.Date
  updatedBy       String
  username        String          @unique
}

model AdminDefaultPermissionDB {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  adminPositionDBId String          @db.ObjectId
  adminPosition     AdminPositionDB @relation(fields: [adminPositionDBId], references: [id], onDelete: Cascade)
  canAdvance        Boolean
  canCreate         Boolean
  canDelete         Boolean
  canUpdate         Boolean
  canViews          Boolean
  createdAt         DateTime        @db.Date
  createdBy         String
  isDeleted         Boolean
  menuPageWebId     String?         @db.ObjectId
  menuPage          MenuPageWebDB?  @relation(fields: [menuPageWebId], references: [id], onDelete: Cascade)
  updatedAt         DateTime        @db.Date
  updatedBy         String

  @@unique([adminPositionDBId, menuPageWebId])
}

model AdminDepartmentDB {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime          @db.Date
  createdBy      String
  description    String
  isActive       Boolean
  isDeleted      Boolean
  name           String            @unique
  updatedAt      DateTime          @db.Date
  updatedBy      String
  adminPositions AdminPositionDB[]
}

model AdminPositionDB {
  id                       String                     @id @default(auto()) @map("_id") @db.ObjectId
  adminDepartmentId        String                     @db.ObjectId
  adminDepartment          AdminDepartmentDB          @relation(fields: [adminDepartmentId], references: [id], onDelete: Cascade)
  createdAt                DateTime                   @db.Date
  createdBy                String
  isActive                 Boolean
  isDeleted                Boolean
  name                     String
  priority                 Int
  updatedAt                DateTime                   @db.Date
  updatedBy                String
  AdminDB                  AdminDB[]
  AdminDefaultPermissionDB AdminDefaultPermissionDB[]

  @@unique([adminDepartmentId, name], map: "uniq_position_name_per_dept")
  @@index([adminDepartmentId])
}

model AgQueueJobDB {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  v            Int      @map("__v")
  adviser      String?
  createdAt    DateTime @db.Date
  errorMessage String?
  eventDocId   String
  jobId        String   @unique(map: "jobId_1")
  priority     Int
  queueSize    Int
  status       String
  type         String
  updatedAt    DateTime @db.Date
  username     String?
}

model AgUserAccountDB {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime          @db.Date
  createdBy       String
  gaSecretEnc     String
  isActive        Boolean
  /// Could not determine type: the field only had null or empty values in the sample set.
  meta            Json?
  /// Could not determine type: the field only had null or empty values in the sample set.
  note            Json?
  origin          String
  position        String
  reserve         String
  statusServe     String
  updatedAt       DateTime          @db.Date
  updatedBy       String
  userLogin       String?
  username        String            @unique
  webname         String
  CustomerAgentDB CustomerAgentDB[]
  PartnerDB       PartnerDB[]
}

model CustomerAgentDB {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  agentId         String          @db.ObjectId
  agUserAccountDB AgUserAccountDB @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @db.Date
  createdBy       String
  customerId      String          @unique
  isActive        Boolean
  note            String
  updatedAt       DateTime        @db.Date
  updatedBy       String
}

model ImageList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @db.Date
  createdBy String
  deleteBy  String
  imageUrl  String
  isDeleted Boolean
  modelName String
  nameFile  String
  updatedAt DateTime @db.Date
  updatedBy String
}

model MenuPageWebDB {
  id                       String                     @id @default(auto()) @map("_id") @db.ObjectId
  /// Field referred in an index, but found no data to define the type.
  link                     Json?                      @unique
  /// Field referred in an index, but found no data to define the type.
  name                     Json?                      @unique
  AdminDefaultPermissionDB AdminDefaultPermissionDB[]
}

model MenuWebDB {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  canAdvance  Boolean
  canCreate   Boolean
  canDelete   Boolean
  canUpdate   Boolean
  canViews    Boolean
  createdAt   DateTime @db.Date
  createdBy   String
  description String
  head        Boolean
  icon        String?
  isDeleted   Boolean?
  isVisible   Boolean
  link        String
  manager     String[]
  name        String   @unique
  parentId    String?  @db.ObjectId
  showOrder   Int
  updatedAt   DateTime @db.Date
  updatedBy   String

  // Self-referential relations for menu hierarchy
  parent   MenuWebDB?  @relation("MenuParentChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children MenuWebDB[] @relation("MenuParentChildren")
}

model PartnerDB {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  agentId         String          @db.ObjectId
