generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type AdjustbetsCockfight {
  /// Multiple data types found: Float: 17.4%, Int: 82.6% out of 23 sampled entries
  commissionRBG Json
  enabled       Boolean
  work          Boolean?
  profile       Int?
  lastError     String?
}

type AdjustbetsMuayStep {
  enabled   Boolean
  work      Boolean?
  profile   Int?
  lastError String?
}

type AdjustbetsSa {
  /// Multiple data types found: Float: 26.1%, Int: 73.9% out of 23 sampled entries
  commissionRAR Json
  enabled       Boolean
  work          Boolean?
  lastError     String?
  lastSavedAt   DateTime? @db.Date
  profile       Int
}

type AdjustbetsSexy {
  enabled     Boolean
  work        Boolean?
  lastError   String?
  lastSavedAt DateTime? @db.Date
  profile     Int
}

type AdjustbetsSlotItp {
  enabled     Boolean
  work        Boolean?
  lastSavedAt DateTime? @db.Date
}

type AdjustbetsSlotJoker {
  enabled     Boolean
  work        Boolean?
  lastSavedAt DateTime? @db.Date
}

type AdjustbetsSlotPlaystar {
  enabled Boolean
  work    Boolean?
}

type AdjustbetsSportsbook {
  work        Boolean?
  commission  AdjustbetsSportsbookCommission
  limits      AdjustbetsSportsbookLimits
  lastError   String?
  lastSavedAt DateTime?                      @db.Date
}

type AdjustbetsSportsbookCommission {
  main  Int
  other Int
  par   Int
  x12   Int
}

type AdjustbetsSportsbookLimits {
  beforeRun       Int
  matchLimitOS    Int
  matchLimitOther Int
  matchLimitX12   Int
  maxOS           Int
  maxOther        Int
  maxPar          Int
  maxX12          Int
  par             Int
  transLimit      Int
}

type AdjustbetsVirtualSports {
  enabled     Boolean
  work        Boolean?
  profile     Int?
  lastSavedAt DateTime? @db.Date
  statusServe String?
}

type AdjustbetsLottoRCW {
  work    Boolean?
  enabled Boolean?
  share   Int?
}

type AdjustbetsLottoRDC {
  work    Boolean?
  enabled Boolean?
  share   Int?
}

model AGUserDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  adviser   String
  createdAt DateTime @default(now()) @db.Date
  createdBy String
  isActive  Boolean
  isDeleted Boolean
  password  String
  updatedAt DateTime @updatedAt @db.Date
  updatedBy String
  userAg    String   @unique
  userLogin String   @unique
  webBaseId String   @db.ObjectId
}

model ActivityLogDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  createdAt DateTime @default(now()) @db.Date
  ipAddress String?
  newData   String?
  recordId  String?
  tableName String?
  userAgent String?
  userId    String
  userType  String
}

model AdminDB {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  adminPositionId String?          @db.ObjectId
  adminPosition   AdminPositionDB? @relation(fields: [adminPositionId], references: [id], onDelete: SetNull)
  webBaseId       String?          @db.ObjectId
  webBase         WebBaseDB?       @relation(fields: [webBaseId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now()) @db.Date
  createdBy       String
  deleteAt        DateTime?        @db.Date
  /// Could not determine type: the field only had null or empty values in the sample set.
  deleteBy        Json?
  email           String?          @unique
  isActive        Boolean
  name            String
  password        String
  /// Could not determine type: the field only had null or empty values in the sample set.
  profile         Json?
  tel             String?
  updatedAt       DateTime         @updatedAt @db.Date
  updatedBy       String
  username        String           @unique
}

model AdminDefaultPermissionDB {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  adminPositionDBId String          @db.ObjectId
  adminPosition     AdminPositionDB @relation(fields: [adminPositionDBId], references: [id], onDelete: Cascade)
  canAdvance        Boolean
  canCreate         Boolean
  canDelete         Boolean
  canUpdate         Boolean
  canViews          Boolean
  createdAt         DateTime        @default(now()) @db.Date
  createdBy         String
  isDeleted         Boolean
  menuPageWebId     String          @db.ObjectId
  menuPage          MenuWebDB       @relation(fields: [menuPageWebId], references: [id], onDelete: Cascade)
  updatedAt         DateTime        @updatedAt @db.Date
  updatedBy         String

  @@unique([adminPositionDBId, menuPageWebId])
}

model AdminDepartmentDB {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime          @default(now()) @db.Date
  createdBy      String
  description    String
  isActive       Boolean
  isDeleted      Boolean
  name           String            @unique
  updatedAt      DateTime          @updatedAt @db.Date
  updatedBy      String
  adminPositions AdminPositionDB[]
}

model AdminPositionDB {
  id                       String                     @id @default(auto()) @map("_id") @db.ObjectId
  adminDepartmentId        String                     @db.ObjectId
  adminDepartment          AdminDepartmentDB          @relation(fields: [adminDepartmentId], references: [id], onDelete: Cascade)
  createdAt                DateTime                   @default(now()) @db.Date
  createdBy                String
  isActive                 Boolean
  isDeleted                Boolean
  name                     String
  priority                 Int
  updatedAt                DateTime                   @updatedAt @db.Date
  updatedBy                String
  AdminDefaultPermissionDB AdminDefaultPermissionDB[]
  admins                   AdminDB[]

  @@unique([adminDepartmentId, name], map: "uniq_position_name_per_dept")
  @@index([adminDepartmentId])
}

model AgUserAccountDB {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime          @default(now()) @db.Date
  createdBy      String
  gaSecretEnc    String
  isActive       Boolean
  /// Could not determine type: the field only had null or empty values in the sample set.
  meta           Json?
  /// Could not determine type: the field only had null or empty values in the sample set.
  note           Json?
  origin         String
  position       String
  reserve        String
  statusServe    String
  updatedAt      DateTime          @updatedAt @db.Date
  updatedBy      String
  userLogin      String            @unique
  username       String            @unique
  webname        String
  SetZero        SetZero[]
  customerAgents CustomerAgentDB[]
  PartnerDB      PartnerDB[]
}

model CustomerAgentDB {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  agentId    String          @db.ObjectId
  agent      AgUserAccountDB @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now()) @db.Date
  createdBy  String
  customerId String          @unique
  isActive   Boolean
  note       String
  updatedAt  DateTime        @updatedAt @db.Date
  updatedBy  String
  deleteAt   DateTime?       @db.Date
  deleteBy   String?
}

model ImageList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now()) @db.Date
  createdBy String
  deleteBy  String
  imageUrl  String
  isDeleted Boolean
  modelName String
  nameFile  String
  updatedAt DateTime @updatedAt @db.Date
  updatedBy String
}

model MenuPageWebDB {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  /// Field referred in an index, but found no data to define the type.
  link Json?  @unique
  /// Field referred in an index, but found no data to define the type.
  name Json?  @unique
}

model MenuWebDB {
  id                       String                     @id @default(auto()) @map("_id") @db.ObjectId
  canAdvance               Boolean
  canCreate                Boolean
  canDelete                Boolean
  canUpdate                Boolean
  canViews                 Boolean
  createdAt                DateTime                   @default(now()) @db.Date
  createdBy                String
  description              String
  head                     Boolean
  icon                     String?
  isDeleted                Boolean?
  isVisible                Boolean
  link                     String
  manager                  String[]
  name                     String                     @unique
  parentId                 String?                    @db.ObjectId
  parent                   MenuWebDB?                 @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children                 MenuWebDB[]                @relation("MenuHierarchy")
  showOrder                Int
  updatedAt                DateTime                   @updatedAt @db.Date
  updatedBy                String
  AdminDefaultPermissionDB AdminDefaultPermissionDB[]
}

model SettingDB {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  name              String?
  logo              String?
  logoText          String?
  logoTextColor     String?
  logoTextSize      Int?
  logoTextFont      String?
  logoTextFontSize  Int?
  logoTextFontColor String?
  facebook          String?
  instagram         String?
  line              String?
  youtube           String?
  website           String?
  address           String?
  tel               String?
  createdBy         String?
  updatedBy         String?
}

model UserDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now()) @db.Date
  createdBy String
  email     String   @unique
  firstname String
  isActive  Boolean
  isDeleted Boolean
  lastname  String
  password  String
  tel       String
  updatedAt DateTime @updatedAt @db.Date
  updatedBy String
  username  String   @unique
}

model WebBaseDB {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime  @default(now()) @db.Date
  createdBy String
  deleteBy  String?
  isActive  Boolean
  isDeleted Boolean
  name      String    @unique
  otpA      String
  otpM      String
  otpS      String
  passA     String
  passM     String
  passS     String
  updatedAt DateTime  @updatedAt @db.Date
  updatedBy String
  AdminDB   AdminDB[]

  @@index([isActive], map: "isActive_1")
}

model WorkHistoryDB {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  createdAt DateTime @default(now()) @db.Date
  /// Could not determine type: the field only had null or empty values in the sample set.
  errorMsg  Json?
  ipAddress String?
  isSuccess Boolean
  newData   String?
  oldData   String?
  recordId  String?  @db.ObjectId
  tableName String
  userAgent String?
  userId    String
  userType  String

  @@index([tableName])
  @@index([recordId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model adjustbets {
  id            String                  @id @default(auto()) @map("_id") @db.ObjectId
  v             Int?                    @map("__v")
  agBaseUrl     String
  /// Multiple data types found: Int: 34.8%, BigInt: 65.2% out of 23 sampled entries
  attemptCount  Json
  cockfight     AdjustbetsCockfight
  createdAt     DateTime                @default(now()) @db.Date
  createdBy     String
  customer      String
  lastError     String
  muayStep      AdjustbetsMuayStep
  overallStatus String                  @default("PENDING")
  pinUsed       String
  sa            AdjustbetsSa
  sexy          AdjustbetsSexy
  slotItp       AdjustbetsSlotItp
  slotJoker     AdjustbetsSlotJoker
  slotPlaystar  AdjustbetsSlotPlaystar
  sportsbook    AdjustbetsSportsbook
  updatedAt     DateTime                @updatedAt @db.Date
  updatedBy     String
  usernameAG    String
  virtualSports AdjustbetsVirtualSports
  lottoRCW      AdjustbetsLottoRCW?
  lottoRDC      AdjustbetsLottoRDC?
}

model admin {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  bankName   String
  bankNumber String
  createdAt  DateTime @db.Date
  /// Could not determine type: the field only had null or empty values in the sample set.
  deleted_at Json?
  firstname  String
  lastname   String
  line       String
  nickname   String
  password   String
  position   String
  team       String
  tel        String
  updatedAt  DateTime @db.Date
  username   String
}

model aguseraccounts {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  /// Field referred in an index, but found no data to define the type.
  username Json?  @unique(map: "username_1")
}

model user {
  id String @id @default(auto()) @map("_id") @db.ObjectId
}

// ระบบ SetZero - สำหรับการ reset ค่าเป็น 0
model SetZero {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  customerId String // รหัสลูกค้า
  agentId    String          @db.ObjectId // ID ของ AG User Account
  agent      AgUserAccountDB @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status     String          @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt  DateTime        @default(now())
  createdBy  String
  updatedAt  DateTime        @updatedAt
  updatedBy  String
}

model PartnerDB {
  // สู้ฟรี	เลขบัญชี	Name	Bank	Tel	Line	ค้างบวก	จ่าย	วิธีคิด	เริ่มทำงาน
  // 0.40	1668972833	สาโรจน์	กสิกรไทย	0915239792		Y	Y	normal	21/5/2021
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  agentId    String          @db.ObjectId
  agent      AgUserAccountDB @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bankName   String
  bankNumber String
  name       String
  tel        String
  line       String
  status     String
  method     String
  startDate  DateTime
  createdAt  DateTime        @default(now()) @db.Date
  createdBy  String
  updatedAt  DateTime        @updatedAt @db.Date
  updatedBy  String
}
