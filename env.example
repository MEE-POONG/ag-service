DATABASE_URL="mongodb://localhost:27017/ag-db"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-here"

# Public origin used to build password-reset and email-verification links.
APP_BASE_URL="http://localhost:3002"

# SMTP email delivery. For Gmail, use an App Password rather than the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-sender@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="AG Service <your-sender@gmail.com>"
# Existing installations may continue using MAIL_USER and MAIL_PASS as aliases.

# The verified address ufa66.oa14@gmail.com is permanently treated as superadmin in server code.

# Cloudflare Images API
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_HASH="your-cloudflare-account-hash"
# For client-side usage (components)
NEXT_PUBLIC_CLOUDFLARE_HASH="your-cloudflare-account-hash" 

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
