{
  "name": "restful-api-nodejs-bet-66",
  "version": "1.0.0",
  "description": "RESTful API with Node.js + MongoDB By BET 66",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "format": "./node_modules/.bin/prettier --write server.js",
    "dev": "nodemon server.js",
    "docker:build": "docker build -t chunwarayut/agservice:latest .",
    "docker:push": "docker push chunwarayut/agservice:latest",
    "serve:start": "pm2 start system/serve.js -n auto-bot-queue",
    "serve:restart": "pm2 restart auto-bot-queue",
    "serve:stop": "pm2 stop auto-bot-queue",
    "serve:delete": "pm2 delete auto-bot-queue",
    "docker:b:p": "npm run docker:build && npm run docker:push"
  },
  "keywords": [
    "RESTFul",
    "API",
    "Node.js",
    "MongoDB",
    "Mongoose",
    "Express.js"
  ],
  "author": "Chun Warayut",
  "license": "MIT",
  "dependencies": {
    "axios": "^0.26.0",
    "bcrypt": "^5.0.1",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.0",
    "chromedriver": "^90.0.0",
    "connect": "^3.7.0",
    "cors": "^2.8.5",
    "dayjs": "^1.9.8",
    "decode-html": "^2.0.0",
    "delay": "^4.3.0",
    "dotenv": "^9.0.2",
    "ent": "^2.2.0",
    "express": "4.17.1",
    "express-validator": "^6.6.1",
    "form-data": "^4.0.0",
    "fs": "^0.0.1-security",
    "generate-password": "^1.6.0",
    "he": "^1.2.0",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.29.1",
    "mongoose": "^5.12.14",
    "node-cmd": "^5.0.0",
    "node-crontab": "^0.0.8",
    "nodemon": "^2.0.7",
    "pm2": "^5.1.2",
    "puppeteer": "^10.2.0",
    "qs": "^6.10.3",
    "querystring": "^0.2.0",
    "selenium-webdriver": "^4.0.0-beta.3",
    "sharp": "^0.25.4",
    "stream": "0.0.2",
    "tesseract.js": "^2.1.1",
    "text-from-image": "^1.1.1",
    "webdriverio": "^7.7.3"
  },
  "devDependencies": {
    "prettier": "1.18.2"
  }
}
